# Environment variables for Chameleon Key Vault
# Copy this file to .env and fill in your values.

# Node.js environment (development, production, test)
NODE_ENV=development

# Logging level (debug, info, warn, error, fatal)
LOG_LEVEL=info

# GCP Project ID for the current environment
GCP_PROJECT_ID=your-gcp-project-id

# Firestore configuration
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION=key_registry
FIRESTORE_DELETION_REQUEST_COLLECTION=deletion_requests
# Optional -- defaults to "analyst_access" if unset. Per-analyst claim/credential records.
FIRESTORE_ANALYST_ACCESS_COLLECTION=analyst_access

# Cloud KMS configuration (DEK operations)
# Key ring and key name match Terraform: google_kms_key_ring.regional / google_kms_crypto_key.key_vault_key
CLOUD_KMS_PROJECT_ID=your-gcp-project-id
CLOUD_KMS_REGION=us-central1
CLOUD_KMS_KEY_RING=chameleon-dev
CLOUD_KMS_KEY_NAME=chameleon-key-vault-dev

# Cloud KMS configuration (asymmetric signing for Certificates of Destruction)
# Key ring and key name match Terraform: google_kms_key_ring.signing / google_kms_crypto_key.certificate_signing_key
CLOUD_KMS_SIGNING_KEY_RING=chameleon-signing-dev
CLOUD_KMS_SIGNING_KEY_NAME=chameleon-cert-signing-dev
CLOUD_KMS_SIGNING_KEY_VERSION=1

# Secret Manager configuration
SECRET_MANAGER_PROJECT_ID=your-gcp-project-id
CMEK_METADATA_SECRET_NAME=chameleon-cmek-master-dev

# GCS audit bucket (matches Terraform: google_storage_bucket.audit_logs)
GCP_AUDIT_BUCKET_NAME=chameleon-audit-logs-dev-your-gcp-project-id

# BigQuery Lineage configuration
# Use fully qualified project.dataset and project.dataset.table
BIGQUERY_DATASET_ID=your-gcp-project-id.lineage_db
BIGQUERY_LINEAGE_TABLE_ID=your-gcp-project-id.lineage_db.lineage_events

# Path to GCP service account key file (for local development/testing)
# export GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
