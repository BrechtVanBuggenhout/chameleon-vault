{
  "name": "chameleon-key-vault",
  "version": "0.1.0",
  "description": "Centralized Key Management Service for Project Chameleon - deterministic AES-256 encryption, key lifecycle management, and cryptographic shredding",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "type-check:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "encryption",
    "key-management",
    "cryptography",
    "compliance",
    "gdpr",
    "data-shredding"
  ],
  "author": "Chameleon",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^8.4.2",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@google-cloud/bigquery": "^8.3.1",
    "@google-cloud/firestore": "^6.8.0",
    "@google-cloud/kms": "^4.2.0",
    "@google-cloud/logging": "^10.2.0",
    "@google-cloud/pubsub": "^4.2.0",
    "@google-cloud/secret-manager": "^5.2.0",
    "@google-cloud/storage": "^7.19.0",
    "avsc": "^5.7.9",
    "axios": "^1.18.1",
    "fastify": "^4.25.0",
    "google-auth-library": "^8.9.0",
    "joi": "^17.11.0",
    "jose": "^5.10.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.1",
    "snowflake-sdk": "^3.1.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/snowflake-sdk": "^1.6.24",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-ts-webcompat-resolver": "^1.0.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "protobufjs": "^7.5.6",
    "protobufjs-cli": "^1.2.1",
    "@grpc/grpc-js": "^1.13.5",
    "form-data": "^4.0.6",
    "picomatch": "^4.0.4",
    "minimatch": "^10.0.0",
    "tmp": "^0.2.6",
    "fast-uri": "^3.1.4",
    "linkify-it": "^5.0.2"
  }
}
